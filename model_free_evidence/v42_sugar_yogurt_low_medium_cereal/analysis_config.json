    "other_milk_spending"
  ],
  "healthy_columns_by_outcome": {
    "fv_y": [
      "fresh_spending"
    ],
    "cereal_y": [
      "low_sugar_cereal_spending",
      "medium_sugar_cereal_spending"
    ],
    "yogurt_y": [
      "regular_sugar_spending"
    ],
    "snack_y": [
      "healthy_snack_spending"
    ],
    "beverage_y": [
      "healthy_beverage_spending"
    ]
  },
  "outcome_allowed_codes": {
