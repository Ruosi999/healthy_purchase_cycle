      2
    ],
    "beverage_y": [
      0,
      1,
      2
    ],
    "milk_y": [
      0,
      1,
      2
    ]
  },
  "healthy_yogurt_definition": "regular sugar; high sugar excluded",
  "healthy_cereal_definition": "low plus medium sugar; high sugar excluded",
  "combined_beverage_healthy_spending": [
    "healthy_beverage_spending",
    "skimmed_milk_spending",
    "low_fat_milk_spending",
    "other_milk_spending"
  ],
  "denominator": "sum of trip food_spend within household-year",
  "year_start": 2008,
  "year_end": 2017,
  "event_window": [
    -3,
    3
